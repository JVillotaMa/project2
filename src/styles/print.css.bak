/* Estilos específicos para impresión */
@media print {
  /* Ocultar botones y elementos no necesarios para impresión */
  button, .no-print {
    display: none !important;
  }
  
  /* Asegurar que el contenido se muestre correctamente */
  .print-container {
    width: 100% !important;
    max-width: 800px !important;
    margin: 0 auto !important;
    padding: 0 !important;
    width: 100%;
    margin: 0;
    padding: 0;
  }
  
  /* Eliminar sombras y bordes innecesarios */
  .print-container * {
    box-shadow: none !important;
    -webkit-print-color-adjust: exact !important;
    color-adjust: exact !important;
  }
  
  /* Ajustar el layout para la impresión */
  .print-flex-row {
    display: flex !important;
    flex-direction: row !important;
  }
  
  /* Ajustar tamaños para impresión */
  .print-width-full {
    width: 100% !important;
  }
  
  .print-width-half {
    width: 50% !important;
  }
  
  /* Ocultar elementos específicos */
  .no-print {
    display: none !important;
  }
  
  /* Forzar el fondo blanco y texto negro */
  body {
    background: white !important;
    color: black !important;
  }
  
  /* Evitar cortes en elementos importantes */
  svg, .chart-container {
    break-inside: avoid;
    page-break-inside: avoid;
  }
}
